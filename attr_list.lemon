/* @file attr_list.lemon
 * @brief Lemon LALR(1) grammar for AsciiDoc block-attribute lists.
 *
 * Grammar:
 *
 *   attr_list  ::= item (',' item)*
 *   item       ::= WORD '=' value       (named attribute)
 *               |  value                (positional attribute)
 *   value      ::= WORD | QUOTED
 *
 * Tokens are produced by the hand-written lexer in attr_list.c.
 * Types and helper functions are in attr_list_impl.h.
 *
 * Generate with:
 *   lemon -T/usr/share/lemon/lempar.c attr_list.lemon
 *
 * A pre-generated copy is committed as attr_list_gen.c.
 */

/* ── Lemon directives ────────────────────────────────────────────────────── */

%name           AqAttr
%token_prefix   AQ_TOK_
%start_symbol   attrlist

/* Token value type: the (pointer, length) span defined in attr_list_impl.h */
%token_type     { AqAttrSpan }

/* Default value for non-semantic tokens (COMMA, EQ). */
%default_type   { int }

/* Non-terminal types that carry semantic values. */
%type name  { AqAttrSpan }
%type value { AqAttrSpan }

/* Extra state passed to every action. */
%extra_argument { struct AqAttrCtx *ctx }

/* Include shared types and helpers from the private header. */
%include {
#include "attr_list_impl.h"
#include <assert.h>

/* ── Helpers ──────────────────────────────────────────────────────────── */

/* Emit a named attribute to the user callback. */
static void emit_named(struct AqAttrCtx *ctx,
                       const char *key,   int key_len,
                       const char *val,   int val_len)
{
    if (!ctx->error && ctx->cb) {
        ctx->cb(ctx->userdata,
                key,  (size_t)key_len,
                val,  (size_t)val_len);
    }
}

/* Emit the next positional attribute (keys "1", "2", …). */
static void emit_positional(struct AqAttrCtx *ctx,
                             const char *val, int val_len)
{
    if (!ctx->error && ctx->cb) {
        char key[12];
        int  klen;
        if (ctx->pos < 10) {
            key[0] = (char)('0' + ctx->pos);
            klen   = 1;
        } else {
            klen = snprintf(key, sizeof(key), "%d", ctx->pos);
        }
        ctx->cb(ctx->userdata,
                key, (size_t)klen,
                val, (size_t)val_len);
    }
    ++ctx->pos;
}
}

/* ── Error handling ──────────────────────────────────────────────────────── */
%syntax_error {
    (void)yymajor; (void)yyminor;
    ctx->error = 1;
}

%stack_overflow {
    ctx->error = 1;
}

/* ── Grammar rules ───────────────────────────────────────────────────────── */

/* Top level: zero or more comma-separated items. */
attrlist ::= .
attrlist ::= itemlist .

/* Item list: one or more items. */
itemlist ::= item .
itemlist ::= itemlist COMMA item .

/* An item is either named (key=value) or positional. */
item ::= name(K) EQ value(V) . {
    emit_named(ctx, K.s, K.len, V.s, V.len);
}
item ::= value(V) . {
    emit_positional(ctx, V.s, V.len);
}

/* Names are bare words only. */
name(A) ::= WORD(W) . { A = W; }

/* Values can be bare words or quoted strings. */
value(A) ::= WORD(W)   . { A = W; }
value(A) ::= QUOTED(Q) . {
    /* Strip surrounding double-quotes. */
    A.s   = Q.s + 1;
    A.len = (Q.len >= 2) ? Q.len - 2 : 0;
}
